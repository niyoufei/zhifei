+def _safe_local_preview_path(*values: Any) -> str:
+    for value in values:
+        text = str(value or "").strip()
+        if not text:
+            continue
+        try:
+            path = Path(text)
+        except Exception:
+            continue
+        if path.exists() and path.is_file():
+            return str(path)
+    return ""
