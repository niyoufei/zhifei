+                            + "</div>",
+                            unsafe_allow_html=True,
+                        )
+                continue
+        st.markdown(card_html, unsafe_allow_html=True)
+        if tags:
+            st.markdown(
+                "<div class='zf-chip-row'>"
+                + "".join(f"<span class='zf-chip'>{html.escape(tag)}</span>" for tag in tags[:6])
