ZF_ACTIONS_KEY=zf-webui-key
ZF_ADMIN_KEY=

# OpenAI text chain
OPENAI_API_KEY_TEXT_MAIN=
OPENAI_API_KEY_TEXT_BACKUP=
OPENAI_API_KEY_AUTOMATION=
OPENAI_TEXT_MODEL_MAIN=gpt-5.4
OPENAI_TEXT_MODEL_BACKUP=gpt-5.4
OPENAI_AUTOMATION_MODEL=gpt-5.4

# Gemini visual chain
GEMINI_API_KEY_A=
GEMINI_API_KEY_B=
GEMINI_IMAGE_MODEL_A=gemini-2.5-flash-image
GEMINI_IMAGE_MODEL_B=gemini-2.5-flash-image

# Optional compatibility / legacy fallbacks
# OPENAI_API_KEY=
# ZF_OPENAI_API_KEY=
# ZF_LLM_MAIN_API_KEY=
# ZF_LLM_FALLBACK1_API_KEY=
# ZF_GOOGLE_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Runtime behavior
ZF_HOST=127.0.0.1
ZF_BACKEND_HOST=127.0.0.1
ZF_WEB_HOST=127.0.0.1
ZF_BACKEND_CONNECT_HOST=127.0.0.1
ZF_WEB_CONNECT_HOST=127.0.0.1
ZF_PUBLIC_WEB_URL=https://doc.niyoufei.com
ZF_ENABLE_GEMINI_TEXT_FALLBACK=0
ZF_OPENAI_PROMPT_CACHE_ENABLED=1
ZF_OPENAI_PROMPT_CACHE_RETENTION=24h
ZF_JOB_LEASE_SECONDS=900
ZF_SHOW_DEV_PANELS=0

# Compatibility-only defaults (/compose, /model_ping)
# ZF_DEFAULT_PROVIDER=openai
# ZF_DEFAULT_MODEL=gpt-5.4
# ZF_DEFAULT_API_KEY=

# Streamlit local key file override (UI-only convenience)
# ZF_KEYS_FILE=.runtime/local_keys.env
