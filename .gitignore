# ===== OS / System junk =====
.DS_Store
**/.DS_Store
Thumbs.db

# ===== Python cache / bytecode =====
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# ===== Backup folders =====
# Local backup snapshots, never commit
/_untracked_backup*/

# ===== ZhiFei_V20.1 generated data =====
# Ignore generated data folders prefixed with ZhiFei_V20.1
**/ZhiFei_V20.1*/
# Keep extra safety rules for JSON/JSONL under same folders
**/ZhiFei_V20.1*/**/*.json
**/ZhiFei_V20.1*/**/*.jsonl

# ===== Project input materials =====
# Raw tender/BoQ/drawing materials are source inputs, not repo code
/projects/inbox/**

# ===== Local runtime / IDE state =====
.bin/
.cursor/
.coverage

