{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zdoc://image-generation/workflow-contract-schema/027n-r4b",
  "title": "ZDoc Image Generation Workflow Contract Schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "registryWorkflowJsonStatus": {
      "enum": [
        "pending_real_workflow",
        "mapped_static_unverified",
        "production_api_workflow_frozen"
      ]
    },
    "productionWorkflowRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![~/])(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!workflows/comfyui(?:/|$))(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001F\\u007F-\\u009F])(?!\\.json$).+\\.json$"
    },
    "manifestWorkflowJsonStatus": {
      "enum": [
        "pending_real_workflow",
        "mapped_static_unverified",
        "production_binding_contract_verified"
      ]
    },
    "productionBindingDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "input_name"
      ],
      "properties": {
        "node_id": {
          "type": [
            "string",
            "integer"
          ],
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "input_name": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      }
    },
    "productionBindingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive_prompt",
        "negative_prompt",
        "candidate_seed",
        "width",
        "height",
        "batch_size",
        "steps",
        "cfg",
        "sampler",
        "scheduler",
        "output_prefix"
      ],
      "properties": {
        "positive_prompt": {
          "$ref": "#/$defs/productionBindingDescriptor"
        },
        "negative_prompt": {
          "$ref": "#/$defs/productionBindingDescriptor"
        },
        "candidate_seed": {
          "$ref": "#/$defs/productionBindingDescriptor"
        },
        "width": {
          "$ref": "#/$defs/productionBindingDescriptor"
        },
        "height": {
          "$ref": "#/$defs/productionBindingDescriptor"
        },
        "batch_size": {
          "$ref": "#/$defs/productionBindingDescriptor"
        },
        "steps": {
          "$ref": "#/$defs/productionBindingDescriptor"
        },
        "cfg": {
          "$ref": "#/$defs/productionBindingDescriptor"
        },
        "sampler": {
          "$ref": "#/$defs/productionBindingDescriptor"
        },
        "scheduler": {
          "$ref": "#/$defs/productionBindingDescriptor"
        },
        "output_prefix": {
          "$ref": "#/$defs/productionBindingDescriptor"
        }
      }
    },
    "manifestWorkflowRecord": {
      "type": "object",
      "required": [
        "workflow_id",
        "workflow_json_ref",
        "workflow_json_status"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "workflow_json_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_json_status": {
          "$ref": "#/$defs/manifestWorkflowJsonStatus"
        },
        "production_binding_contract": {
          "$ref": "#/$defs/productionBindingContract"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "workflow_json_status"
            ],
            "properties": {
              "workflow_json_status": {
                "const": "production_binding_contract_verified"
              }
            }
          },
          "then": {
            "required": [
              "production_binding_contract"
            ]
          },
          "else": {
            "not": {
              "required": [
                "production_binding_contract"
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "workflow_json_status"
        ],
        "properties": {
          "workflow_json_status": {
            "const": "production_api_workflow_frozen"
          }
        }
      },
      "then": {
        "required": [
          "workflow_json_ref"
        ],
        "properties": {
          "workflow_json_ref": {
            "$ref": "#/$defs/productionWorkflowRelativePath"
          }
        }
      }
    }
  ],
  "required": [
    "workflow_id",
    "intended_model",
    "required_inputs",
    "output_expectations",
    "safety_policy",
    "no_video_generation",
    "runtime_forbidden",
    "runtime_enabled",
    "allowed_task_type",
    "disabled_video_generation"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "intended_model": {
      "type": "string",
      "minLength": 1
    },
    "required_inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "output_expectations": {
      "type": "object",
      "required": [
        "output_type",
        "single_image_only",
        "auto_upload"
      ],
      "additionalProperties": true,
      "properties": {
        "output_type": {
          "type": "string"
        },
        "single_image_only": {
          "const": true
        },
        "auto_upload": {
          "const": false
        }
      }
    },
    "safety_policy": {
      "type": "object",
      "required": [
        "local_only",
        "no_model_weight_read",
        "no_env_read"
      ],
      "additionalProperties": true,
      "properties": {
        "local_only": {
          "const": true
        },
        "no_model_weight_read": {
          "const": true
        },
        "no_env_read": {
          "const": true
        }
      }
    },
    "no_video_generation": {
      "const": true
    },
    "runtime_forbidden": {
      "type": "object",
      "required": [
        "comfyui_start",
        "localhost_access",
        "inference",
        "image_generation"
      ],
      "additionalProperties": true,
      "properties": {
        "comfyui_start": {
          "const": true
        },
        "localhost_access": {
          "const": true
        },
        "inference": {
          "const": true
        },
        "image_generation": {
          "const": true
        }
      }
    },
    "runtime_enabled": {
      "const": false
    },
    "allowed_task_type": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "disabled_video_generation": {
      "const": true
    },
    "workflow_json_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflow_json_status": {
      "$ref": "#/$defs/registryWorkflowJsonStatus"
    },
    "alternative_workflow_json_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mapping_confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "manual_confirmation_required": {
      "type": "boolean"
    },
    "manual_confirmation_reason": {
      "type": "string"
    },
    "model_reference_hint": {
      "type": "string",
      "minLength": 1
    },
    "mapping_source": {
      "type": "string",
      "minLength": 1
    },
    "mapped_from_comfyui_root_policy": {
      "type": "string",
      "minLength": 1
    },
    "r5k_environment_mapping_status": {
      "type": "string",
      "minLength": 1
    },
    "custom_nodes_mapping_status": {
      "type": "string",
      "minLength": 1
    },
    "inferred_custom_node_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "package_mapping_unverified": {
      "type": "boolean"
    }
  }
}
