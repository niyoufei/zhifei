[Unit]
Description=DocGen Autoplan Immutable Runtime Supervisor
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=docgen
Group=docgen
UMask=0077
WorkingDirectory=/opt/docgen-autoplan/current
Environment=PYTHONPATH=/opt/docgen-autoplan/current
# This root-owned 0600 file supplies release identity and runtime credentials.
# Values are intentionally never embedded in or generated by this unit.
EnvironmentFile=/etc/docgen-autoplan/runtime.env

ExecStart=/opt/docgen-autoplan/runtime/bin/python3 /opt/docgen-autoplan/current/scripts/runtime_supervisor.py run --release-dir /opt/docgen-autoplan/current --python /opt/docgen-autoplan/runtime/bin/python3 --backend-port 8010 --ui-port 8501 --expected-system-id docgen-system --expected-release-id ${ZF_RELEASE_ID} --expected-manifest-digest ${ZF_RELEASE_MANIFEST_DIGEST} --expected-source-digest ${ZF_RELEASE_SOURCE_DIGEST} --expected-runtime-digest ${ZF_RUNTIME_DIGEST} --env-file /etc/docgen-autoplan/runtime.env --state-dir /var/lib/docgen-autoplan/state --log-dir /var/log/docgen-autoplan
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=append:/var/log/docgen-autoplan/runtime-supervisor.out.log
StandardError=append:/var/log/docgen-autoplan/runtime-supervisor.err.log

[Install]
WantedBy=multi-user.target
