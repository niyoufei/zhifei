[Unit]
Description=DocGen Autoplan FastAPI Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/docgen
Environment=PYTHONPATH=/opt/docgen
Environment=ZF_KEYS_FILE=/opt/docgen/.runtime/local_keys.env
Environment=ZF_HOST=127.0.0.1
Environment=ZF_PORT=8010
EnvironmentFile=-/opt/docgen/.runtime/local_keys.env
ExecStart=/opt/docgen/.venv/bin/python3 /opt/docgen/scripts/run_backend_service.py
Restart=always
RestartSec=3

StandardOutput=append:/opt/docgen/logs/uvicorn.out.log
StandardError=append:/opt/docgen/logs/uvicorn.err.log

[Install]
WantedBy=multi-user.target
